[
{% set _ci = hostvars['localhost']['cluster_inv'].all.children | default({}) %}
{% set slurm_nodes = (
    (_ci.slurm_node.hosts | default({})) |
    combine(_ci.slurm_node_x86_64.hosts | default({})) |
    combine(_ci.slurm_node_aarch64.hosts | default({}))
  ) | dict2items %}
{% for item in slurm_nodes %}
    {
        "hostname": "{{ item.key }}.{{ hostvars['localhost']['domain_name'] | default('localdomain') }}",
        "hostaddr": "{{ item.value.ansible_host | default(item.key) }}",
        "ip_address": "{{ item.value.ansible_host | default(item.key) }}",
        "subrole": "Compute"
    }{% if not loop.last %},{% endif %}
{% endfor %}

]